class DataFetcher:
    def __init__(self):
        self.cache = {}
        self.cache_timeout = 30  # seconds

    async def fetch_top_coins(self, limit=50):
        # Use CoinGecko markets endpoint
        key = f"top_{limit}"
        now = time.time()
        if key in self.cache and now - self.cache[key]['ts'] < self.cache_timeout:
            return self.cache[key]['data']
        url = "https://api.coingecko.com/api/v3/coins/markets"
        async with aiohttp.ClientSession() as s:
            params = {'vs_currency': 'usd', 'order': 'market_cap_desc', 'per_page': limit, 'page': 1, 'sparkline': False}
            try:
                async with s.get(url, params=params, timeout=10) as resp:
                    data = await resp.json()
                    self.cache[key] = {'ts': now, 'data': data}
                    return data
            except Exception as e:
                logger.warning("CoinGecko top coins fetch failed: %s", e)
                return []
    async def fetch_new_coins(self, limit=30):
        # Similar to above -> newest ids by id_desc
        key = f"new_{limit}"
        now = time.time()
        if key in self.cache and now - self.cache[key]['ts'] < self.cache_timeout:
            return self.cache[key]['data']
        url = "https://api.coingecko.com/api/v3/coins/markets"
        async with aiohttp.ClientSession() as s:
            params = {'vs_currency': 'usd', 'order': 'id_desc', 'per_page': limit, 'page': 1, 'sparkline': False}
            try:
                async with s.get(url, params=params, timeout=10) as resp:
                    data = await resp.json()
                    self.cache[key] = {'ts': now, 'data': data}
                    return data
            except Exception as e:
                logger.warning("CoinGecko new coins fetch failed: %s", e)
                return []

    async def fetch_ohlcv(self, symbol: str, timeframe='1m', limit=100):
        key = f"ohlcv_{symbol}_{timeframe}_{limit}"
        now = time.time()
        if key in self.cache and now - self.cache[key]['ts'] < self.cache_timeout:
            return self.cache[key]['data']
        # Try exchange ohlcv
        try:
            o = await exchange_manager.fetch_order_book(symbol)
        except Exception:
            o = None
        # Attempt to use exchanges for OHLCV (some will support)
        for ex in exchange_manager.exchanges.values():
            try:
                ohlcv = await ex.fetch_ohlcv(symbol, timeframe, limit=limit)
                df = pd.DataFrame(ohlcv, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
                df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
                df['symbol'] = symbol
                df['rsi'] = RSIIndicator(df['close'], window=14).rsi()
                self.cache[key] = {'ts': now, 'data': df}
                return df
            except Exception:
                continue
        # fallback: generate sample ohlcv
        df = self._generate_sample_ohlcv(symbol, limit)
        self.cache[key] = {'ts': now, 'data': df}
        return df

    def _generate_sample_ohlcv(self, symbol, limit=100, volatility=0.02):
        base_price = random.uniform(100, 50000) if 'BTC' in symbol else random.uniform(0.0001, 100)
        data = []
        current_time = datetime.now()
        last_close = base_price
        for i in range(limit):
            open_p = last_close
            change = random.uniform(-volatility, volatility)
            close_p = open_p * (1 + change)
            high = max(open_p, close_p) * (1 + random.uniform(0.001, 0.01))
            low = min(open_p, close_p) * (1 - random.uniform(0.001, 0.01))
            vol = random.uniform(1000, 100000)
            ts = int((current_time - timedelta(minutes=limit - i)).timestamp() * 1000)
            data.append([ts, open_p, high, low, close_p, vol])
            last_close = close_p
        df = pd.DataFrame(data, columns=['timestamp', 'open', 'high', 'low', 'close', 'volume'])
        df['timestamp'] = pd.to_datetime(df['timestamp'], unit='ms')
        df['symbol'] = symbol
        df['rsi'] = RSIIndicator(df['close'], window=14).rsi()
        return df

