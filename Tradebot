# --------------------------- WEBSOCKET MANAGER ---------------------------
class WebSocketManager:
    def __init__(self, port=WEBSOCKET_PORT):
        self.port = port
        self.clients = set()
        self.server = None

    async def handle(self, websocket, path):
        self.clients.add(websocket)
        logger.info("WS client connected: %s", websocket.remote_address)
        try:
            async for msg in websocket:
                # This server is push-oriented. Accept simple subscribe messages.
                try:
                    data = json.loads(msg)
                    if data.get("type") == "ping":
                        await websocket.send(json.dumps({"type": "pong"}))
                except Exception:
                    pass
        except websockets.exceptions.ConnectionClosed:
            pass
        finally:
            self.clients.remove(websocket)
            logger.info("WS client disconnected")

    async def broadcast(self, message: dict):
        if not self.clients:
            return
        msg = json.dumps(message, default=str)
        await asyncio.gather(*(c.send(msg) for c in list(self.clients) if not c.closed), return_exceptions=True)

    async def start_server(self):
        try:
            self.server = await websockets.serve(self.handle, "0.0.0.0", self.port)
            logger.info("WebSocket server started on port %s", self.port)
        except Exception as e:
            logger.error("Websocket server failed to start: %s", e)

