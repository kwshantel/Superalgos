    def get_dark_pool_data(self, symbol):
        prints = db.get_dark_prints(symbol)
        signals = []
        for p in prints:
            try:
                ts, ticker, price, volume, source = p
            except Exception:
                continue
            trade_value = float(price or 0) * int(volume or 0)
            if trade_value > self.block_trade_threshold:
                signals.append({"type": "BLOCK_TRADE", "size": trade_value, "price": price, "timestamp": ts, "sentiment": random.choice(["BULLISH","BEARISH"]), "venue": source})
        if len(prints) >= self.accumulation_threshold:
            total_size = sum(int(p[3]) * float(p[2] or 0) for p in prints)
            signals.append({"type":"ACCUMULATION","prints":len(prints),"total_size":total_size,"timeframe_minutes":60,"price_level": sum(float(p[2] or 0) for p in prints)/len(prints) if prints else 0})
        return signals

    def analyze_dark_pool_signals(self, signals, symbol, current_price):
        analysis = {"institutional_buy_pressure":0,"institutional_sell_pressure":0,"accumulation_score":0,"signal_strength":0,"recommendation":"HOLD","confidence":0}
        for s in signals:
            if s['type']=="BLOCK_TRADE":
                if s['sentiment']=="BULLISH":
                    analysis['institutional_buy_pressure'] += s['size']/100000
                else:
                    analysis['institutional_sell_pressure'] += s['size']/100000
            elif s['type']=="ACCUMULATION":
                analysis['accumulation_score'] += s['prints'] * (s['total_size']/100000)
        total = analysis['institutional_buy_pressure'] + analysis['accumulation_score'] - analysis['institutional_sell_pressure']
        analysis['signal_strength'] = total
        analysis['confidence'] = min(100, max(0, abs(total)*10))
        if total > 2:
            analysis['recommendation'] = "STRONG_BUY"
        elif total > 0.5:
            analysis['recommendation'] = "BUY"
        elif total < -2:
            analysis['recommendation'] = "STRONG_SELL"
        elif total < -0.5:
            analysis['recommendation'] = "SELL"
        return analysis

