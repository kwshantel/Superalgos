class RiskManager:
    def __init__(self, portfolio_manager):
        self.portfolio = portfolio_manager
        self.daily_pnl = 0.0
        self.daily_trades = 0
        self.circuit_breaker = False
        self.consecutive_losses = 0
        self.last_trade_time = {}

    def calculate_position_size(self, symbol, price, confidence=0.5, volatility=1.0):
        portfolio_value = self.portfolio.get_portfolio_value()
        base_risk = portfolio_value * float(CONFIG.get("TRADING", {}).get("RISK_PER_TRADE", 0.02))
        conf_factor = 0.5 + confidence*0.5
        adjusted = base_risk*conf_factor / (price if price>0 else 1)
        # enforce max 10% position
        max_alloc = portfolio_value*0.1/price if price>0 else 0
        return min(adjusted, max_alloc)

    def can_execute_trade(self, trade_type, amount, price, symbol):
        value = amount*price
        if value > self.portfolio.get_portfolio_value()*0.1:
            return False, "Position size exceeds 10% of portfolio"
        if self.daily_trades >= 100:
            return False, "Daily trade limit hit"
        if self.circuit_breaker:
            return False, "Circuit breaker active"
        return True, "OK"

    def update_daily_pnl(self, pnl_change):
        self.daily_pnl += pnl_change
        if pnl_change < 0:
            self.consecutive_losses += 1
        else:
            self.consecutive_losses = 0
        if self.daily_pnl <= -self.portfolio.get_portfolio_value()*float(CONFIG.get("TRADING", {}).get("DAILY_LOSS_LIMIT", 0.05)):
            self.circuit_breaker = True
            asyncio.create_task(alert_system.add_alert("DAILY_LOSS_LIMIT", "Daily loss limit reached", "high"))

