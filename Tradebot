class PortfolioOptimizer:
    def modern_portfolio_theory(self, symbols):
        returns = np.array([random.uniform(0.01,0.2) for _ in symbols])
        risks = np.array([random.uniform(0.05,0.2) for _ in symbols])
        n = len(symbols) or 1
        weights = np.array([1.0/n]*n)
        port_return = float(np.sum(returns*weights))
        port_risk = float(np.sqrt(np.dot(weights.T, np.dot(np.eye(n)*0.1, weights))))
        return {"expected_return":port_return, "risk":port_risk, "weights":weights.tolist()}

