class Database:
    def __init__(self, db_path=DB_PATH):
        self.conn = sqlite3.connect(str(db_path), check_same_thread=False)
        self.cursor = self.conn.cursor()
        self._init_tables()

    def _init_tables(self):
        # trades, portfolio, ai_training_data, alerts, dark_prints, options_flow, sentiment, crypto, macro
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS trades (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                symbol TEXT,
                action TEXT,
                amount REAL,
                price REAL,
                value REAL,
                trade_type TEXT,
                confidence REAL,
                pnl REAL,
                strategy TEXT,
                dark_pool TEXT,
                price_improvement REAL
            )
        ''')
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS portfolio (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                total_value REAL,
                cash_balance REAL,
                positions_value REAL,
                daily_pnl REAL
            )
        ''')
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS ai_training_data (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                symbol TEXT,
                action TEXT,
                amount REAL,
                price REAL,
                confidence REAL,
                features TEXT,
                success BOOLEAN,
                pnl REAL,
                market_conditions TEXT
            )
        ''')
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS alerts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                type TEXT,
                message TEXT,
                priority TEXT,
                data TEXT
            )
        ''')
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS dark_prints (ts TEXT, ticker TEXT, price REAL, volume INTEGER, source TEXT)''')
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS options_flow (ts TEXT, ticker TEXT, strike REAL, expiry TEXT, side TEXT, premium REAL, source TEXT)''')
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS sentiment (ts TEXT, platform TEXT, ticker TEXT, sentiment REAL, text TEXT)''')
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS crypto (ts TEXT, symbol TEXT, price REAL, marketcap REAL, source TEXT)''')
        self.cursor.execute('''CREATE TABLE IF NOT EXISTS macro (ts TEXT, indicator TEXT, value REAL, source TEXT)''')
        self.conn.commit()

    def log_trade(self, symbol, action, amount, price, trade_type="manual", confidence=0.5, pnl=0, strategy="", dark_pool=None, price_improvement=0):
        value = amount * price
        ts = datetime.utcnow().isoformat()
        self.cursor.execute('''
            INSERT INTO trades (timestamp, symbol, action, amount, price, value, trade_type, confidence, pnl, strategy, dark_pool, price_improvement)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (ts, symbol, action, amount, price, value, trade_type, confidence, pnl, strategy, dark_pool, price_improvement))
        self.conn.commit()

    def log_portfolio(self, total_value, cash_balance, positions_value, daily_pnl):
        ts = datetime.utcnow().isoformat()
        self.cursor.execute('''
            INSERT INTO portfolio (timestamp, total_value, cash_balance, positions_value, daily_pnl)
            VALUES (?, ?, ?, ?, ?)
        ''', (ts, total_value, cash_balance, positions_value, daily_pnl))
        self.conn.commit()

    def log_alert(self, alert_type, message, priority, data):
        ts = datetime.utcnow().isoformat()
        self.cursor.execute('''
            INSERT INTO alerts (timestamp, type, message, priority, data)
            VALUES (?, ?, ?, ?, ?)
        ''', (ts, alert_type, message, priority, json.dumps(data)))
        self.conn.commit()

    def get_recent_alerts(self, limit=10):
        self.cursor.execute('SELECT type, message, priority, timestamp FROM alerts ORDER BY id DESC LIMIT ?', (limit,))
