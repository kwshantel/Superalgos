class AILearning:
    def __init__(self):
        self.model = RandomForestClassifier(n_estimators=100, random_state=42)
        self.scaler = StandardScaler()
        self.is_trained = False
        self.history = []

    def extract_features(self, market_data, patterns):
        features = []
        if market_data is not None and len(market_data) > 0:
            features.extend([
                market_data['close'].iloc[-1],
                market_data['close'].pct_change().iloc[-1] if len(market_data) > 1 else 0,
                market_data['high'].iloc[-1] - market_data['low'].iloc[-1],
                market_data['volume'].iloc[-1],
                market_data['volume'].mean()
            ])
        else:
            features.extend([0]*5)
        features.extend([
            patterns.get('rsi',50),
            1 if patterns.get('god_candle') else 0,
            1 if patterns.get('breakout_up') else 0,
            1 if patterns.get('breakout_down') else 0,
            patterns.get('confidence',0.6)
        ])
        while len(features) < 15:
            features.append(0.0)
        return features[:15]

    def record_trade_for_learning(self, symbol, action, amount, price, confidence, features, success=True, pnl=0):
        db.cursor.execute('''
            INSERT INTO ai_training_data (timestamp,symbol,action,amount,price,confidence,features,success,pnl,market_conditions)
            VALUES (?,?,?,?,?,?,?,?,?,?)
        ''', (datetime.utcnow().isoformat(), symbol, action, amount, price, confidence, str(features), int(success), pnl, '{}'))
        db.conn.commit()

    def train_model(self):
        db.cursor.execute("SELECT features, success FROM ai_training_data WHERE features IS NOT NULL")
        rows = db.cursor.fetchall()
        X, y = [], []
        for r in rows:
            try:
                feats = eval(r[0])
                X.append(feats)
                y.append(int(r[1]))
            except Exception:
                continue
        if len(X) < 20:
            return False, "Not enough data"
        X = np.array(X)
        y = np.array(y)
        Xs = self.scaler.fit_transform(X)
        self.model.fit(Xs, y)
        self.is_trained = True
        acc = self.model.score(Xs, y)
        self.history.append({'timestamp': datetime.utcnow().isoformat(), 'accuracy': acc, 'samples': len(X)})
        joblib.dump({'model': self.model, 'scaler': self.scaler, 'history': self.history}, AI_MODEL_PATH)
        return True, f"Trained on {len(X)} samples (acc={acc:.2%})"

    def predict_success_probability(self, features):
        if not self.is_trained:
            return 0.5
        try:
            arr = np.array(features).reshape(1, -1)
            arr_s = self.scaler.transform(arr)
            return float(self.model.predict_proba(arr_s)[0][1])
        except Exception:
            return 0.5

