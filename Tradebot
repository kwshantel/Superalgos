    async def execute_dark_pool_order(self, symbol, amount, price, action):
        # Requires dark_pool_activity to exist for symbol
        if symbol not in self.dark_pool_activity:
            return False, "No dark pool activity"
        activity = self.dark_pool_activity[symbol]
        pool = activity['dark_pool']
        price_improvement = random.uniform(0.0001, 0.001)
        if action.upper() == "BUY":
            improved_price = price * (1 - price_improvement)
        else:
            improved_price = price * (1 + price_improvement)
        fee = self.dark_pools[pool]['fee_rate'] * amount * improved_price
        execution = {
            "symbol": symbol, "amount": amount, "price": improved_price, "action": action,
            "dark_pool": pool, "price_improvement": price_improvement, "fee": fee, "timestamp": datetime.utcnow().isoformat()
        }
        # Attempt to update portfolio via bot.portfolio, which is set later
        try:
            ok = bot.portfolio.update_position(symbol, amount, improved_price, action, 'dark_pool', 'dark_pool', pool, price_improvement)
            if ok:
                await alert_system.add_alert("DARK_POOL_EXECUTION", f"Executed dark pool order for {symbol} on {self.dark_pools[pool]['name']}", "medium", execution)
                return True, execution
            else:
                return False, "Portfolio update failed"
        except Exception as e:
            return False, str(e)

