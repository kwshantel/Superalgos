class PatternDetector:
    def detect_god_candle(self, df):
        if df is None or len(df) < 2:
            return False
        cur = df.iloc[-1]
        prev = df.iloc[-2]
        price_change = abs(cur['close'] - prev['close']) / max(prev['close'], 1e-9)
        volume_spike = cur['volume'] > df['volume'].mean() * 2.5
        return price_change >= 0.08 and volume_spike

    def detect_breakout(self, df):
        if df is None or len(df) < 20:
            return False, False
        dfc = df.copy()
        dfc['high20'] = dfc['high'].rolling(20).max()
        dfc['low20'] = dfc['low'].rolling(20).min()
        cur = dfc.iloc[-1]
        breakout_up = cur['close'] > dfc['high20'].iloc[-2]
        breakout_down = cur['close'] < dfc['low20'].iloc[-2]
        return breakout_up, breakout_down

    def calculate_rsi(self, df, period=14):
        if df is None or len(df) < period:
            return 50
        rsi = RSIIndicator(df['close'], window=period).rsi()
        return float(rsi.iloc[-1])

    def detect_all_patterns(self, df, symbol):
        return {
            'god_candle': self.detect_god_candle(df),
            'breakout_up': self.detect_breakout(df)[0],
            'breakout_down': self.detect_breakout(df)[1],
            'rsi': self.calculate_rsi(df),
            'symbol': symbol,
            'confidence': random.uniform(0.5, 0.95)
        }

