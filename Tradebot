class PortfolioManager:
    def __init__(self):
        self.value = float(CONFIG.get("PORTFOLIO", {}).get("USD", 100000.0))
        self.cash = self.value
        self.positions = {}
        self.daily_pnl = 0.0
        self.trade_history = []

    def update_position(self, symbol, amount, price, action, trade_type="auto", strategy="", dark_pool=None, price_improvement=0):
        if symbol not in self.positions:
            self.positions[symbol] = {'amount': 0.0, 'entry_price': 0.0, 'current_price': price, 'pnl': 0.0, 'total_invested': 0.0}
        pos = self.positions[symbol]
        if action.upper() == "BUY":
            total_cost = pos['amount']*pos['entry_price'] + amount*price
            total_amount = pos['amount'] + amount
            pos['entry_price'] = total_cost/total_amount if total_amount > 0 else price
            pos['amount'] = total_amount
            pos['total_invested'] += amount*price
            self.cash -= amount*price
        elif action.upper() == "SELL":
            if pos['amount'] < amount:
                return False
            self.cash += amount*price
            pnl = amount*(price - pos['entry_price'])
            pos['pnl'] += pnl
            self.daily_pnl += pnl
            pos['amount'] -= amount
            if pos['amount'] <= 0:
                del self.positions[symbol]
        pos['current_price'] = price
        db.log_trade(symbol, action, amount, price, trade_type, 0.5, pos.get('pnl',0), strategy, dark_pool, price_improvement)
        self.trade_history.append({'timestamp': datetime.utcnow().isoformat(), 'symbol': symbol, 'action': action, 'amount': amount, 'price': price, 'trade_type': trade_type, 'strategy': strategy, 'dark_pool': dark_pool, 'price_improvement': price_improvement})
        self.record_portfolio_snapshot()
        return True

    def close_all_positions(self):
        for symbol in list(self.positions.keys()):
            pos = self.positions[symbol]
            amount = pos['amount']
            price = pos['current_price']
            if amount > 0:
                self.update_position(symbol, amount, price, "SELL", "manual", "close_all")
        return True

    def record_portfolio_snapshot(self):
        positions_value = sum(p['amount']*p['current_price'] for p in self.positions.values())
        db.log_portfolio(self.value, self.cash, positions_value, self.daily_pnl)

    def get_portfolio_value(self):
        return self.cash + sum(p['amount']*p['current_price'] for p in self.positions.values())

    def get_positions_value(self):
        return sum(p['amount']*p['current_price'] for p in self.positions.values())

