@app.route('/')
def dashboard():
    mode = "live" if LIVE_MODE else "simulated"
    recent_alerts = db.get_recent_alerts()
    return render_template_string(DASH_HTML, recent_alerts=recent_alerts, websocket_port=WEBSOCKET_PORT, config_mode=mode)

# settings endpoints (minimal)
@app.route('/api/toggle-trading', methods=['POST'])
def api_toggle_trading():
    bot.auto_trading_enabled = not bot.auto_trading_enabled
    return jsonify({"auto_trading": bot.auto_trading_enabled})

@app.route('/api/trade', methods=['POST'])
def api_trade():
    data = request.get_json()
    symbol = data.get("symbol")
    action = data.get("action")
    qty = float(data.get("quantity", 0))
    if not symbol or not action or qty <= 0:
        return jsonify({"status":"error","message":"missing params"}), 400
    # synchronous wrapper for async execute
    price = asyncio.get_event_loop().run_until_complete(exchange_manager.get_price(symbol))
    success = portfolio.update_position(symbol, qty, price, action.upper(), "manual")
    if success:
        return jsonify({"status":"success","message":"trade executed"})
    else:
        return jsonify({"status":"error","message":"trade failed"}), 400

@app.route('/api/close-all', methods=['POST'])
def api_close_all():
    count = len(portfolio.positions)
    portfolio.close_all_positions()
    return jsonify({"status":"success","message":f"closed {count} positions"})

# --------------------------- MAIN RUN ---------------------------
async def _start_services():
    # start websocket server
    await websocket_manager.start_server()
    # start exchange init
    await exchange_manager.init_exchanges()
    # start bot
    asyncio.create_task(bot.run())

def start_background_tasks():
    # background python thread for periodic external fetches
    t = threading.Thread(target=run_data_fetching, daemon=True)
    t.start()
    # start websocket loop in separate thread? We'll let asyncio handle it in main

def run_flask():
    app.run(host="0.0.0.0", port=DASH_PORT, debug=False, use_reloader=False)

def main():
    loop = asyncio.get_event_loop()
    # start websocket & bot
    loop.run_until_complete(_start_services())
    # start background fetcher thread
    start_background_tasks()
    # open browser
    try:
        webbrowser.open(f"http://localhost:{DASH_PORT}")
    except Exception:
        logger.warning("Could not auto-open browser")
    # run Flask in main thread (blocking)
    run_flask()

if __name__ == "__main__":
    main()
