class SpreadTrading:
    def __init__(self, exchange_manager, portfolio, risk_manager):
        self.exchange_manager = exchange_manager
        self.portfolio = portfolio
        self.risk_manager = risk_manager

    async def detect_arbitrage_opportunities(self, symbols):
        opps = []
        # check cross-exchange pricing
        for s in symbols:
            prices = {}
            for name, ex in self.exchange_manager.exchanges.items():
                try:
                    ticker = await ex.fetch_ticker(s)
                    prices[name] = float(ticker.get('last', 0))
                except:
                    continue
            if len(prices) >= 2:
                max_p = max(prices.values()); min_p = min(prices.values())
                if max_p/min_p > 1.005:
                    opps.append({"symbol":s,"buy_exchange":min(prices, key=prices.get),"sell_exchange":max(prices, key=prices.get),
                                 "buy_price":min_p,"sell_price":max_p,"spread":(max_p-min_p)/min_p*100})
        return opps

    async def execute_spread_trade(self, symbol, amount, buy_exchange, sell_exchange, buy_price, sell_price):
        can, reason = self.risk_manager.can_execute_trade('spread', amount, buy_price, symbol)
