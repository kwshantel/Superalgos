class ExchangeManager:
    def __init__(self, config_exchanges: Dict):
        self.config_exchanges = config_exchanges
        self.exchanges = {}
        self.loop = asyncio.get_event_loop()

    async def init_exchanges(self):
        for name, cfg in self.config_exchanges.items():
            try:
                enabled = cfg.get("enabled", False)
                if not enabled:
                    logger.info(f"{name} disabled in config")
                    continue
                cls = getattr(ccxt, name)
                ex = cls({
                    "apiKey": cfg.get("apiKey") or cfg.get("api_key") or cfg.get("apiKey", ""),
                    "secret": cfg.get("secret") or cfg.get("secret", ""),
                    "enableRateLimit": True,
                })
                # If testnet
                if cfg.get("testnet", False):
                    # Some exchanges expose set_sandbox_mode
                    try:
                        if hasattr(ex, "set_sandbox_mode"):
                            ex.set_sandbox_mode(True)
                    except Exception:
                        pass
                self.exchanges[name] = ex
                logger.info("Initialized exchange: %s", name)
            except Exception as e:
                logger.error("Failed to init exchange %s: %s", name, e)

    async def get_price(self, symbol: str):
        # attempt on configured exchanges
        for ex in self.exchanges.values():
            try:
                ticker = await ex.fetch_ticker(symbol)
                return float(ticker.get('last', ticker.get('close', 0)))
            except Exception:
                continue
        # Fallback: try CoinGecko
        try:
            async with aiohttp.ClientSession() as s:
                url = f"https://api.coingecko.com/api/v3/simple/price?ids={symbol.lower()}&vs_currencies=usd"
                async with s.get(url) as resp:
                    data = await resp.json()
                    # best-effort mapping
                    for k, v in data.items():
                        return float(v.get('usd', 0))
        except Exception:
            pass
        return 0.0

    async def fetch_order_book(self, symbol: str, limit: int = 10):
        for ex in self.exchanges.values():
            try:
                ob = await ex.fetch_order_book(symbol, limit)
                return ob
            except:
                continue
        # fallback simulated
        price = random.uniform(1000, 50000) if 'BTC' in symbol else random.uniform(0.0001, 100)
        bids = [[price * (1 - random.uniform(0.0005, 0.005)), random.uniform(0.1, 10)] for _ in range(10)]
        asks = [[price * (1 + random.uniform(0.0005, 0.005)), random.uniform(0.1, 10)] for _ in range(10)]
        return {'bids': bids, 'asks': asks}

    async def execute_order(self, symbol: str, amount: float, price: Optional[float], action: str, order_type="market", exchange_name: Optional[str] = None):
        """
        Execute market or limit order. Returns order dict or None.
        IMPORTANT: This will place real orders in live mode. Ensure exchanges are configured.
        """
        if not LIVE_MODE:
            logger.warning("Live mode disabled; skipping order execution.")
            return {"id": "sim_" + str(random.randint(1000, 9999)), "status": "simulated", "price": price, "amount": amount}

        # Choose exchange
        ex_list = [self.exchanges[exchange_name]] if exchange_name and exchange_name in self.exchanges else list(self.exchanges.values())
        for ex in ex_list:
            try:
                side = action.lower()
                if order_type == "market":
                    order = await ex.create_order(symbol, "market", side, amount)
                else:
                    order = await ex.create_order(symbol, "limit", side, amount, price)
                logger.info("Placed order on %s: %s", getattr(ex, 'id', 'unknown'), order)
                return order
            except Exception as e:
                logger.warning("Order failed on exchange %s: %s", getattr(ex, 'id', 'unknown'), e)
                continue
        logger.error("All exchanges failed to place order for %s", symbol)
        return None

